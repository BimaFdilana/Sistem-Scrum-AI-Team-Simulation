# ===========================================================================
# Contoh .env untuk deploy Docker (VPS). Salin jadi `.env`, lalu isi nilainya:
#   cp .env.docker.example .env
# ===========================================================================

APP_NAME="ScrumSpace"
APP_ENV=production
APP_DEBUG=false
# Kosongkan untuk HTTP via IP; isi domain (tanpa https://) untuk HTTPS otomatis.
# Contoh: APP_DOMAIN=scrum.namadomain.com
APP_DOMAIN=
APP_URL=http://localhost

# Biarkan kosong saat pertama jalan — entrypoint akan generate otomatis.
# Setelah itu SALIN nilai yang tampil di log ke sini agar permanen.
APP_KEY=

# --- Admin pertama (dibuat otomatis saat migrasi pertama) ---
WORKSPACE_ADMIN_NAME="Product Owner"
WORKSPACE_ADMIN_EMAIL=admin@contoh.com
WORKSPACE_ADMIN_PASSWORD=ganti-dengan-password-min-14-karakter

# --- Database (SQLite, tersimpan di volume Docker) ---
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

# --- Hermes (opsional; abaikan bila hanya pakai CLIProxyAPI) ---
HERMES_API_BASE_URL=http://127.0.0.1:8643/v1
HERMES_API_KEY=
HERMES_API_MODEL=scrumagent
HERMES_API_TIMEOUT=120

# --- CLIProxyAPI gateway (WAJIB diisi) ---
# Di dalam Docker, Laravel menjangkau gateway via http://cliproxy:8317
# (sudah diatur di docker-compose.yml — tidak perlu diubah).
CLIPROXY_BASE_URL=http://cliproxy:8317
# Kunci untuk Management API (boleh string acak apa saja, min. 16 karakter).
# Contoh generate: openssl rand -hex 16
CLIPROXY_MANAGEMENT_KEY=
# Kunci untuk API /v1 (dipakai website saat memanggil model via gateway).
CLIPROXY_API_KEY=
CLIPROXY_TIMEOUT=15
# Versi CLIProxyAPI (lihat https://github.com/router-for-me/CLIProxyAPI/releases)
CLIPROXY_VERSION=8.0.23

# --- Demo project sementara (satu port unik per project) ---
DEMO_PORT_FROM=9110
DEMO_PORT_TO=9130
DEMO_TTL_MINUTES=60

# --- Lainnya (default aman untuk VPS pribadi) ---
LOG_LEVEL=warning
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
